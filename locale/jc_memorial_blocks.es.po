msgid "2025 Memorial Block"
msgstr "Bloque Conmemorativo de 2025"

msgid "2026 Memorial Block"
msgstr "Bloque Conmemorativo de 2026"

msgid "Enable or disable memorial block sounds."
msgstr "Activar o desactivar los sonidos de los bloques conmemorativos."

msgid "Player not found."
msgstr "Jugador no encontrado."

msgid "Memorial block sounds disabled."
msgstr "Los sonidos de los bloques conmemorativos están desactivados."

msgid "Memorial block sounds enabled."
msgstr "Los sonidos de los bloques conmemorativos están activados."

msgid "Usage: /memorial_sounds <on|off>"
msgstr "Uso: /memorial_sounds <on|off>"

msgid "Show the memorial notices again on next login."
msgstr "Mostrar los avisos conmemorativos de nuevo en el próximo inicio de sesión."

msgid "Memorial notices reset."
msgstr "Avisos conmemorativos restablecidos."

msgid "Memorial block sounds can be disabled with /memorial_sounds off."
msgstr "Los sonidos de los bloques conmemorativos se pueden desactivar con /memorial_sounds off."

msgid "This setting is saved after you leave the game."
msgstr "Esta configuración se guarda después de salir del juego."

msgid "Show this around town to show you love the original Just Test. REMEMBER THE TEST."
msgstr "Muestra esto por la ciudad para demostrar que amas el Just Test original. ¡RECUERDA EL TEST!"

msgid "This is a dedication block to your ideas, your server, and you."
msgstr "Este es un bloque dedicado a tus ideas, tu servidor y a ti."

msgid "WE MISS AND LOVE YOU!"
msgstr "¡TE EXTRAÑAMOS Y TE QUEREMOS!"